{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ale-sanchez-g/luchoAI/sentinel/schemas/pr-management-report.schema.json",
  "title": "Project Sentinel pull request management report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "executionId",
    "generatedAt",
    "repository",
    "tool",
    "limitations",
    "pullRequest",
    "decision",
    "finalOutcome",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/definitions/schemaVersion"
    },
    "reportType": {
      "const": "pr-management-report"
    },
    "executionId": {
      "$ref": "common.schema.json#/definitions/executionId"
    },
    "generatedAt": {
      "$ref": "common.schema.json#/definitions/timestamp"
    },
    "repository": {
      "$ref": "common.schema.json#/definitions/repositoryRef"
    },
    "tool": {
      "$ref": "common.schema.json#/definitions/tool"
    },
    "limitations": {
      "$ref": "common.schema.json#/definitions/limitations"
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "url",
        "created",
        "headSha"
      ],
      "properties": {
        "number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": "boolean"
        },
        "headSha": {
          "$ref": "common.schema.json#/definitions/sha"
        }
      }
    },
    "decision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/definitions/outcome"
        }
      ]
    },
    "finalOutcome": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/definitions/outcome"
        }
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "status",
          "detail"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "status": {
            "enum": [
              "DONE",
              "SKIPPED",
              "FAILED"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}