{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ale-sanchez-g/luchoAI/sentinel/schemas/jest-attribution.schema.json",
  "title": "Per-test-file execution attribution written by Sentinel's Jest reporter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "available", "tests"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "provider": { "enum": ["babel", "v8"] },
    "available": { "type": "boolean" },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testFile", "status", "passed", "failed", "skipped", "todo", "files"],
        "properties": {
          "testFile": { "$ref": "common.schema.json#/definitions/relativePath" },
          "status": { "enum": ["passed", "failed", "error"] },
          "passed": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 },
          "todo": { "type": "integer", "minimum": 0 },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "statements", "functions", "branches", "lines"],
              "properties": {
                "file": { "$ref": "common.schema.json#/definitions/relativePath" },
                "statements": { "$ref": "#/definitions/pair" },
                "functions": { "$ref": "#/definitions/pair" },
                "branches": { "$ref": "#/definitions/pair" },
                "lines": { "$ref": "#/definitions/pair" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0 }
    }
  }
}
