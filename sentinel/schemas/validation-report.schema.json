{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ale-sanchez-g/luchoAI/sentinel/schemas/validation-report.schema.json",
  "title": "Project Sentinel test execution and validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "executionId",
    "generatedAt",
    "repository",
    "tool",
    "limitations",
    "commands",
    "tests",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/definitions/schemaVersion"
    },
    "reportType": {
      "const": "validation-report"
    },
    "executionId": {
      "$ref": "common.schema.json#/definitions/executionId"
    },
    "generatedAt": {
      "$ref": "common.schema.json#/definitions/timestamp"
    },
    "repository": {
      "$ref": "common.schema.json#/definitions/repositoryRef"
    },
    "tool": {
      "$ref": "common.schema.json#/definitions/tool"
    },
    "limitations": {
      "$ref": "common.schema.json#/definitions/limitations"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "category",
          "argv",
          "required",
          "status",
          "exitCode",
          "durationMs",
          "startedAt",
          "outputTail",
          "artifacts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "jest",
              "command",
              "npm-audit",
              "audit-signatures",
              "lockfile-check"
            ]
          },
          "category": {
            "enum": [
              "test",
              "build",
              "lint",
              "security",
              "integrity",
              "other"
            ]
          },
          "argv": {
            "$ref": "common.schema.json#/definitions/stringList"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "ERROR",
              "TIMED_OUT",
              "NOT_RUN"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "outputTail": {
            "type": "string"
          },
          "artifacts": {
            "$ref": "common.schema.json#/definitions/pathList"
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework",
        "discovered",
        "executedFiles",
        "total",
        "passed",
        "failed",
        "skipped",
        "todo",
        "runtimeErrors",
        "durationMs",
        "success",
        "files"
      ],
      "properties": {
        "framework": {
          "type": [
            "string",
            "null"
          ]
        },
        "discovered": {
          "type": "integer",
          "minimum": 0
        },
        "executedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "todo": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeErrors": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "testFile",
              "status",
              "passed",
              "failed",
              "skipped",
              "todo",
              "durationMs",
              "failureMessage"
            ],
            "properties": {
              "testFile": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "PASSED",
                  "FAILED",
                  "SKIPPED",
                  "NOT_EXECUTED",
                  "ERROR"
                ]
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "skipped": {
                "type": "integer",
                "minimum": 0
              },
              "todo": {
                "type": "integer",
                "minimum": 0
              },
              "durationMs": {
                "type": "integer"
              },
              "failureMessage": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredPassed",
        "failedRequired",
        "notRunRequired"
      ],
      "properties": {
        "requiredPassed": {
          "type": "boolean"
        },
        "failedRequired": {
          "$ref": "common.schema.json#/definitions/stringList"
        },
        "notRunRequired": {
          "$ref": "common.schema.json#/definitions/stringList"
        }
      }
    }
  }
}