{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ale-sanchez-g/luchoAI/sentinel/schemas/execution-summary.schema.json",
  "title": "Project Sentinel execution summary (audit record of one run)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "executionId",
    "generatedAt",
    "repository",
    "tool",
    "limitations",
    "stage",
    "vulnerabilities",
    "dependencyChanges",
    "impactedFiles",
    "tests",
    "coverage",
    "gates",
    "decision",
    "pullRequest",
    "codeownersAssignments",
    "reports"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/definitions/schemaVersion"
    },
    "reportType": {
      "const": "execution-summary"
    },
    "executionId": {
      "$ref": "common.schema.json#/definitions/executionId"
    },
    "generatedAt": {
      "$ref": "common.schema.json#/definitions/timestamp"
    },
    "repository": {
      "$ref": "common.schema.json#/definitions/repositoryRef"
    },
    "tool": {
      "$ref": "common.schema.json#/definitions/tool"
    },
    "limitations": {
      "$ref": "common.schema.json#/definitions/limitations"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "vulnerabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "ids",
          "severity",
          "package"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "ids": {
            "$ref": "common.schema.json#/definitions/stringList"
          },
          "severity": {
            "$ref": "common.schema.json#/definitions/severity"
          },
          "package": {
            "type": "string"
          }
        }
      }
    },
    "dependencyChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "from",
          "to"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "impactedFiles": {
      "$ref": "common.schema.json#/definitions/pathList"
    },
    "tests": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executed",
            "passed",
            "failed",
            "skipped"
          ],
          "properties": {
            "executed": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/definitions/coverageStatus"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/gateId"
          },
          "status": {
            "$ref": "common.schema.json#/definitions/gateStatus"
          }
        }
      }
    },
    "decision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/definitions/outcome"
        }
      ]
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "url"
      ],
      "properties": {
        "number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "codeownersAssignments": {
      "$ref": "common.schema.json#/definitions/stringList"
    },
    "reports": {
      "$ref": "common.schema.json#/definitions/stringList"
    }
  }
}